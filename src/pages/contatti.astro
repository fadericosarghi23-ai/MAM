---
/**
 * Contatti: foto di apertura come il sorgente. In più (per il SEO locale e l'usabilità) il blocco
 * NAP con microdati PostalAddress: nome, indirizzo, email, telefono, orari, indicazioni stradali.
 */
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import { site } from '../data/site';
import { contactHero } from '../data/contenuti';

const title = '[[DA COMPILARE: title SEO contatti, es. "Contatti | <nome> — <città>"]]';
const description = '[[DA COMPILARE: meta description contatti, 140-160 caratteri]]';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contatti', href: '/contatti/' }];
const prov = site.indirizzo.provincia;
---
<Layout title={title} description={description} pageType="ContactPage" crumbs={crumbs}>
  <h1 class="sr-only">Contatti</h1>
  <div class="contact-hero container reveal"><Picture img={contactHero} sizes="100vw" eager /></div>

  <div class="container">
    <div class="contact-info reveal" itemscope itemtype="https://schema.org/PostalAddress">
      <p style="color:var(--ink);font-weight:600;font-size:1.1rem">{site.nome}</p>
      <p class="muted">
        <span itemprop="streetAddress">{site.indirizzo.via}</span>, <span itemprop="postalCode">{site.indirizzo.cap}</span>
        <span itemprop="addressLocality">{site.indirizzo.citta}</span>{prov && <> (<span itemprop="addressRegion">{prov}</span>)</>}
      </p>
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.telefono && <a href={`tel:${site.telefonoE164}`}>{site.telefono}</a>}
      {site.ricevimento && <p class="muted mt-2">{site.ricevimento}</p>}
      {site.mapsUrl && <a href={site.mapsUrl} target="_blank" rel="noopener">Indicazioni stradali</a>}
    </div>
  </div>
</Layout>
