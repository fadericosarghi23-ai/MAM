---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title={`Richiesta inviata | ${site.nome}`} description="La tua richiesta è stata inviata: ti ricontatterò al più presto." noindex>
<section class="page-head bg-sand" style="min-height: 70svh"> <div class="container narrow"> <p class="eyebrow mb-2">Grazie</p> <h1 class="h1-page">Ho ricevuto la tua richiesta</h1> <p class="lead mt-3">Ti ricontatterò al più presto. Nel frattempo puoi dare un’occhiata alle mie realizzazioni.</p> <div class="btn-row mt-4"> <a href="/progetti/" class="btn btn-primary">Le mie realizzazioni</a> <a href="/" class="btn btn-outline">Torna alla home</a> </div> </div> </section>
</Layout>
