---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ProcessCards from '../components/ProcessCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { servizi } from '../data/servizi';
import { team } from '../data/team';
import { progetti, progetto } from '../data/progetti';
import { heroSlides, progettiHome, numeriHome, aree } from '../data/contenuti';

const title = 'Geom. Brissoni Stefano | Studio tecnico di progettazione a Scanzorosciate (BG)';
const description = site.descrizione;
const fotoStudio = progetto('appartamento-zanica').immagini[1];
// Brissoni: niente FAQ (il cliente non ne ha) → sezione e FAQPage tolte.
---
<Layout title={title} description={description} transparent>
<section class="hero" aria-label="Realizzazioni in evidenza"> <div class="hero-slides" data-hero> {heroSlides.map((s, i) => <figure class:list={['hero-slide', { 'is-active': i === 0 }]} data-title={s.titolo} data-location={s.luogo} data-href={s.href}> <Picture img={s.img} eager={i === 0} class="full-img" /> </figure>)} </div> <div class="container hero-content"> <p class="eyebrow-light mb-3">{site.nome} · {site.attivita} · {site.indirizzo.citta}</p> <h1 class="h1">Progettazione <em>ricercata</em></h1> <div class="hero-meta"> <div> <p class="lead">Stile di qualità per un design unico</p> <div class="btn-row"> <a href="/progetti/" class="btn btn-primary">Le mie realizzazioni</a> <a href="/contatti/#richiesta" class="btn btn-outline-light">Mettiti in contatto</a> </div> </div> <div class="hero-caption" aria-live="polite"> <span class="label">Nella foto</span> <a href={heroSlides[0].href} class="link-underline" data-hero-caption>{heroSlides[0].titolo} · {heroSlides[0].luogo}</a> <div class="hero-dots" role="group" aria-label="Scegli immagine"> {heroSlides.map((s, i) => <button type="button" aria-label={`Mostra ${s.titolo}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>)} </div> </div> </div> </div> </section>

<section class="section"> <div class="container split"> <div class="reveal"> <div class="ratio-45"> <Picture img={fotoStudio} sizes="(min-width: 1024px) 38vw, 92vw" /> </div> </div> <div class="reveal"> <p class="eyebrow mb-2">Studio tecnico di progettazione</p> <h2 class="h2">Chi sono</h2> <div class="prose mt-3 lead"> {/* testo intro della hero della mappa (verbatim): troppo lungo sopra la foto, sta qui */} <p>Un’attenta e continua ricerca dello stile inteso come mix di materiali, colori e accessori, il quale accostamento veste la casa con eleganza e bellezza. E’ proprio questo desiderio di bellezza che spinge a non tralasciare alcun dettaglio in ogni aspetto della progettazione.</p> <p>Brissoni Stefano, tecnico progettista con sede a Scanzorosciate, inizia la propria attività nel 2016 ponendo l’enfasi sulla continua ricerca della bellezza.</p> </div> <div class="stats mt-4"> {numeriHome.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> <a href="/studio/" class="btn btn-outline mt-4">Chi sono</a> </div> </div> </section>

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Servizi</p> <h2 class="h2">I miei servizi</h2> {/* [[DA VALIDARE: sottotitolo composto da noi con l’inizio del blocco intro servizi]] */} <p class="lead mt-2">Dalla progettazione preliminare all’ottenimento dell’agibilità.</p> </div> <a href="/servizi/" class="btn btn-outline">Tutti i servizi</a> </div> <ul class="services services-3 reveal"> {servizi.map((s) => <li class="service"> <Icon name={s.icona} class="icon" /> <h3 class="h4"><a href={`/servizi/#${s.id}`} class="link-underline">{s.nome}</a></h3> <p>{s.breve}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Come lavoro</p> {/* [[DA VALIDARE: titolo composto da noi dal blocco intro servizi]] */} <h2 class="h2">Dal progetto all’agibilità</h2> </div> <a href="/servizi/" class="text-link link-underline">Tutti i servizi</a> </div> <ProcessCards /> </div> </section>

<section class="section" style="padding-top: 0"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Realizzazioni</p> <h2 class="h2">Le mie realizzazioni</h2> </div> <a href="/progetti/" class="text-link link-underline">Tutte le {progetti.length} realizzazioni</a> </div> <div class="projects-grid"> {progettiHome.map((slug) => <ProjectCard p={progetto(slug)} />)} </div> </div> </section>

<section class="section bg-ink"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Dove lavoro</p> {/* [[DA VALIDARE: titolo e frase scritti da noi sui luoghi delle realizzazioni]] */} <h2 class="h2">Da Scanzorosciate alla provincia di Bergamo</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.72)">Lo studio ha sede a Scanzorosciate. Il conteggio segue le realizzazioni pubblicate.</p> </div> </div> <ul class="areas reveal"> {aree.map((a) => <li class="area"> <span>{a.conteggio}</span> <strong>{a.nome}</strong> <p>{a.comuni}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Chi sono</p> <h2 class="h2">Geometra libero professionista dal 2016</h2> <p class="lead mt-2">Laureato in Ingegneria Civile e Ambientale, con una rete di professionisti, imprese e fornitori.</p> </div> <a href="/studio/#team" class="text-link link-underline">Chi sono</a> </div> <div class="team-strip reveal"> {team.slice(0, 7).map((m) => <a href={`/studio/#${m.id}`} title={`${m.nome}, ${m.ruolo}`}> <Picture img={m.foto} sizes="(min-width: 768px) 14vw, 33vw" /> </a>)} </div> </div> </section>


<section class="section"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Dove sono</p> <h2 class="h2">{site.nome} a {site.indirizzo.citta}</h2> <p class="lead mt-3">[[DA COMPILARE: come ricevere i clienti in studio, una frase di circa 100 caratteri]]</p> <div class="contact-cards mt-4"> <div class="contact-card"> <h3>Indirizzo</h3> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia})</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Telefono</h3> {site.telefono && <p><a href={`tel:${site.telefonoE164}`}>Tel. {site.telefono}</a></p>} {site.cellulare && <p><a href={`tel:${site.cellulareE164}`}>Cell. {site.cellulare}</a></p>} </div> <div class="contact-card"> <h3>Email</h3> <p><a href={`mailto:${site.email}`}>{site.email}</a></p> {site.pec && <p>PEC {site.pec}</p>} </div> </div> </div> <div class="map reveal"> <MapEmbed span={0.012} /> </div> </div> </section>
<Cta />
<script>
var e=document.querySelector(`[data-hero]`);if(e){let t=[...e.querySelectorAll(`.hero-slide`)],n=[...document.querySelectorAll(`[data-dot]`)],r=document.querySelector(`[data-hero-caption]`),i=window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,a=0,o,s=e=>{t[a].classList.remove(`is-active`),n[a].setAttribute(`aria-current`,`false`),a=(e+t.length)%t.length;let i=t[a];i.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)),i.classList.add(`is-active`),n[a].setAttribute(`aria-current`,`true`),r&&(r.textContent=`${i.dataset.title} · ${i.dataset.location}`,r.href=i.dataset.href||`#`)},c=()=>{i||(o=window.setInterval(()=>s(a+1),6e3))};n.forEach((e,t)=>e.addEventListener(`click`,()=>{window.clearInterval(o),s(t),c()})),window.addEventListener(`load`,()=>t.forEach(e=>e.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)))),c()}
</script>
</Layout>
