---
/** Mappa del sito: elenco delle pagine (utile a utenti e crawler). */
import Layout from '../layouts/Layout.astro';
import { nav } from '../data/nav';
import { progetti } from '../data/progetti';
import { site } from '../data/site';

const title = `Mappa del sito | ${site.nome}`;
const description = 'Elenco delle pagine del sito.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Mappa del sito', href: '/mappa-del-sito/' }];
---
<Layout title={title} description={description} crumbs={crumbs}>
  <div class="container section">
    <h1 class="h-title">Mappa del sito</h1>
    <ul style="margin-top:1.5rem;display:grid;gap:.5rem">
      <li><a class="link-underline" href="/">Home</a></li>
      {nav.map((v) => <li><a class="link-underline" href={v.href}>{v.label}</a></li>)}
    </ul>
    <h2 class="h-title" style="margin-top:2rem">Progetti</h2>
    <ul style="margin-top:1rem;display:grid;gap:.5rem">
      {progetti.map((p) => <li><a class="link-underline" href={`/progetti/${p.slug}/`}>{p.titolo}</a></li>)}
    </ul>
    <h2 class="h-title" style="margin-top:2rem">Informazioni legali</h2>
    <ul style="margin-top:1rem;display:grid;gap:.5rem">
      <li><a class="link-underline" href="/privacy-policy/">Privacy policy</a></li>
      <li><a class="link-underline" href="/cookie-policy/">Cookie policy</a></li>
    </ul>
  </div>
</Layout>
