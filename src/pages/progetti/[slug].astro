---
/**
 * Scheda progetto: apertura a tutta larghezza, titolo + luogo/anno, dati (cliente, destinazione,
 * intervento, stato, team), descrizione (testo indicizzabile per il SEO), galleria con lightbox,
 * freccia di ritorno. Stessa struttura del sorgente.
 */
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { progetti } from '../../data/progetti';
import { galleryClass, fullSrc } from '../../lib/media';
import { site } from '../../data/site';

export function getStaticPaths() {
  return progetti.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const title = `${p.titolo} | ${site.nome}`;
const description = p.descrizione;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Progetti', href: '/progetti/' },
  { name: p.titolo, href: `/progetti/${p.slug}/` },
];
---
<Layout title={title} description={description} pageType="ItemPage" ogType="article" crumbs={crumbs}>
  <article>
    <div class="project-hero"><Picture img={p.hero} sizes="100vw" eager /></div>
    <div class="container">
      <header class="project-head reveal">
        <h1>{p.titolo}</h1>
        <p class="place-year">{p.luogo} · {p.anno}</p>
        <div class="project-meta">
          <p><b>Cliente:</b> {p.cliente}</p>
          <p><b>Destinazione d’uso:</b> {p.destinazione}</p>
          <p><b>Intervento:</b> {p.intervento}</p>
          <p><b>Stato:</b> {p.stato}</p>
          <p><b>Team:</b> {p.team}</p>
        </div>
      </header>

      <p class="narrow center muted reveal mt-4">{p.descrizione}</p>

      <div class="project-gallery" data-gallery>
        {p.gallery.map((img) => (
          <figure class:list={['reveal', galleryClass(img)]}>
            <button type="button" data-full={fullSrc(img)} data-alt={img.alt} aria-label="Ingrandisci immagine" style="display:contents">
              <Picture img={img} sizes="(min-width:640px) 50vw, 100vw" />
            </button>
          </figure>
        ))}
      </div>

      <div class="project-back-wrap">
        <a class="project-back" href="/progetti/" aria-label="Torna ai progetti">←</a>
      </div>
    </div>
  </article>

  <div class="lightbox" data-lb aria-hidden="true">
    <button type="button" class="close" data-lb-close aria-label="Chiudi">×</button>
    <img data-lb-img alt="">
  </div>
</Layout>

<script>
  // Lightbox della galleria: apre l'immagine a schermo intero, frecce + Esc.
  const lb = document.querySelector<HTMLElement>('[data-lb]');
  const lbImg = lb?.querySelector<HTMLImageElement>('[data-lb-img]');
  const items = [...document.querySelectorAll<HTMLButtonElement>('.project-gallery [data-full]')];
  let idx = 0;
  const open = (i: number) => {
    if (!lb || !lbImg) return;
    idx = (i + items.length) % items.length;
    lbImg.src = items[idx].dataset.full || '';
    lbImg.alt = items[idx].dataset.alt || '';
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  };
  const close = () => { lb?.classList.remove('is-open'); document.body.style.overflow = ''; };
  items.forEach((b, i) => b.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
  lb?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === lb || t.hasAttribute('data-lb-close')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (!lb?.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') open(idx + 1);
    if (e.key === 'ArrowLeft') open(idx - 1);
  });
</script>
