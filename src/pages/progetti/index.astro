---
/**
 * Progetti (works): griglia a 2 colonne di quadrati 1:1, titolo in overlay all'hover.
 * Stessa impaginazione del sorgente. H1 nascosto per il SEO.
 */
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { progetti } from '../../data/progetti';

const title = '[[DA COMPILARE: title SEO pagina progetti, es. "Progetti | <nome> — <città>"]]';
const description = '[[DA COMPILARE: meta description progetti, 140-160 caratteri]]';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Progetti', href: '/progetti/' }];
---
<Layout title={title} description={description} pageType="CollectionPage" crumbs={crumbs}>
  <div class="container">
    <h1 class="sr-only">Progetti</h1>
    <div class="works-grid">
      {progetti.map((p) => (
        <a class="work-card reveal" href={`/progetti/${p.slug}/`} aria-label={p.titolo}>
          <Picture img={p.thumb} sizes="(min-width:640px) 50vw, 100vw" />
          <span class="overlay"><span>{p.titolo}</span></span>
        </a>
      ))}
    </div>
  </div>
</Layout>
