---
/**
 * Studio: apertura + presentazione + organigramma ad albero
 * (Fondatori con foto → Collaboratori → Hanno collaborato).
 */
import Layout from '../layouts/Layout.astro';
import { studioIntro, studioHero, fondatori, collaboratori, hannoCollaborato } from '../data/team';

const title = 'Studio · MAM Architetti — architetti a Vicenza';
const description = 'Lo studio MAM Architetti a Vicenza: fondatori, collaboratori e approccio progettuale.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Studio', href: '/studio/' }];
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<Layout title={title} description={description} pageType="AboutPage" crumbs={crumbs}>
  <h1 class="sr-only">Studio</h1>
  <div class="about-hero container"><img src={studioHero.src} alt={studioHero.alt} width="1600" height="900" fetchpriority="high" decoding="async"></div>

  <div class="container">
    <p class="about-intro">{studioIntro}</p>

    <section class="org section">
      <p class="org-label">Fondatori</p>
      <div class="org-founders">
        {fondatori.map((f) => (
          <div class="founder" id={f.id}>
            {f.foto
              ? <img class="photo" src={f.foto} alt={f.nome} width="118" height="118" loading="lazy" decoding="async">
              : <div class="photo placeholder" title={`Aggiungi la foto di ${f.nome}`} aria-hidden="true">{initials(f.nome)}</div>}
            <div class="nome">{f.nome}</div>
            <div class="ruolo">{f.ruolo}</div>
          </div>
        ))}
      </div>

      {collaboratori.length > 0 && (
        <>
          <div class="org-link"></div>
          <p class="org-label">Collaboratori</p>
          <div class="org-collabs">{collaboratori.map((n) => <span>{n}</span>)}</div>
        </>
      )}

      {hannoCollaborato.length > 0 && (
        <>
          <div class="org-link"></div>
          <p class="org-label">Hanno collaborato</p>
          <div class="org-leaves">{hannoCollaborato.map((n) => <span>{n}</span>)}</div>
        </>
      )}
    </section>
  </div>
</Layout>
