---
/**
 * Studio (about): foto di apertura, paragrafo di presentazione, elenchi di persone
 * (Fondatori / Collaboratori / Hanno collaborato). Stessa struttura del sorgente.
 */
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import { studioIntro, studioHero, fondatori, collaboratori, hannoCollaborato } from '../data/team';

const title = '[[DA COMPILARE: title SEO studio, es. "Studio | <nome> — architetti a <città>"]]';
const description = '[[DA COMPILARE: meta description studio, 140-160 caratteri]]';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Studio', href: '/studio/' }];
---
<Layout title={title} description={description} pageType="AboutPage" crumbs={crumbs}>
  <h1 class="sr-only">Studio</h1>
  <div class="about-hero container reveal"><Picture img={studioHero} sizes="100vw" eager /></div>
  <div class="container">
    <p class="about-intro reveal">{studioIntro}</p>

    <div class="people section">
      <div class="reveal">
        <h2>Fondatori</h2>
        <ul>{fondatori.map((f) => <li>{f.nome}</li>)}</ul>
      </div>
      {collaboratori.length > 0 && (
        <div class="reveal">
          <h2>Collaboratori</h2>
          <ul>{collaboratori.map((n) => <li>{n}</li>)}</ul>
        </div>
      )}
      {hannoCollaborato.length > 0 && (
        <div class="reveal">
          <h2>Hanno collaborato</h2>
          <ul>{hannoCollaborato.map((n) => <li>{n}</li>)}</ul>
        </div>
      )}
    </div>
  </div>
</Layout>
